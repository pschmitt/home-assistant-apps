{
  "name": "Zabbix Agent",
  "version": "1.7.2",
  "slug": "zabbix-agent",
  "description": "Zabbix Network Monitoring Agent",
  "url": "https://github.com/pschmitt/home-assistant-apps/tree/main/zabbix-agent",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "system",
  "boot": "auto",
  "host_network": true,
  "host_ipc": true,
  "ports": {
    "10050/tcp": 10050
  },
  "image": "ghcr.io/pschmitt/{arch}-home-assistant-app-zabbix-agent",
  "options": {
    "server": "zabbix-server.local",
    "serveractive": "zabbix-server.local",
    "hostname": "homeassistant"
  },
  "schema": {
    "server": "str",
    "serveractive": "str",
    "hostname": "str",
    "tlspskidentity": "str?",
    "tlspsksecret": "str?",
    "userparameter": "str?"
  }
}
